# Copiar a .env. Solo valores ficticios de desarrollo. Nunca subir un .env real.

# Backend
APP_ENV=local
# Clave para firmar los JWT. En cada entorno real, usar una cadena aleatoria de 32+ bytes.
APP_SECRET_KEY=cambiar-en-cada-entorno
DATABASE_URL=postgresql+asyncpg://ot:ot@db:5432/ot
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Sesión (JWT)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Almacenamiento de objetos (MinIO local, S3 compatible en la nube)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=ot-files
S3_REGION=us-east-1

# Mail (Mailpit local)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@ot.local
