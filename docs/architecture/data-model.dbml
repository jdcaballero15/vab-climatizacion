// Modelo de datos (borrador v0.1). Se visualiza pegando este archivo en https://dbdiagram.io
// Reglas (ver ADR 0005):
//  - Todas las tablas llevan id uuid, created_at, updated_at y deleted_at (borrado lógico).
//    Para no repetir, se omiten abajo salvo que importen.
//  - Fechas de negocio y precios viven solo en tablas de transacción.
//  - Lo marcado "ADMIN" no se expone al rol técnico (ver ADR 0006).
//  - Nombres de tablas y columnas en inglés. Etiquetas de negocio en español en las notas.

Enum user_role {
  admin
  technician
  owner
}

Enum order_kind {
  on_site
  workshop
}

Enum order_status {
  pending      [note: 'Pendiente']
  assigned     [note: 'Asignada']
  in_progress  [note: 'En curso']
  done         [note: 'Terminada']
  invoiced     [note: 'Facturada']
  paid         [note: 'Cobrada']
  cancelled    [note: 'Cancelada']
}

Enum stage_type {
  pickup    [note: 'Retiro']
  workshop  [note: 'Taller']
  delivery  [note: 'Devolución']
}

Enum stage_status {
  pending
  in_progress
  done
}

Enum order_source {
  manual
  maintenance
}
Enum order_channel {
  whatsapp
  email
  phone
  in_person    [note: 'Presencial: en la oficina o pedido al técnico en el lugar']
}

Enum client_segment {
  private_person [note: 'Particular']
  business       [note: 'Comercio']
  government     [note: 'Estado']
  healthcare     [note: 'Sanatorio o clínica']
  hotel
  unclassified   [note: 'Sin clasificar']
}

Enum tax_condition {
  final_consumer         [note: 'Consumidor final']
  registered_taxpayer    [note: 'Responsable inscripto']
  monotributo
}

Enum closure_outcome {
  done
  needs_pickup   [note: 'Requiere retiro: convierte la orden en orden de taller']
  needs_revisit  [note: 'Requiere otra visita: vuelve a administración para reprogramar']
  not_done       [note: 'No se pudo hacer, con motivo: vuelve a administración (E05-08)']
}

Enum equipment_condition {
  working
  working_with_notes [note: 'Funciona con observaciones: exige observación']
  not_working
}

Enum not_done_reason {
  client_absent  [note: 'Cliente ausente o sin acceso']
  missing_part   [note: 'Falta repuesto o herramienta']
  beyond_repair  [note: 'El equipo no tiene arreglo']
}

Enum cancel_reason {
  entered_by_mistake [note: 'Cargada por error']
  duplicate          [note: 'Duplicada']
  client_cancelled   [note: 'El cliente la canceló']
  other              [note: 'Otro, con texto obligatorio (E04-07). Lista a validar con la oficina']
}

Enum no_signature_reason {
  client_absent [note: 'Cliente ausente']
  refused       [note: 'No quiso firmar']
  other         [note: 'Otro, con texto obligatorio. Lista a validar con la oficina']
}

Enum signature_purpose {
  closure
  pickup
  delivery
}

Enum maintenance_frequency {
  monthly
  semiannual
  annual
}

Enum checklist_item_kind {
  ok_no
  measurement
}

Enum stock_location_type {
  depot
  vehicle
}

Enum stock_movement_reason {
  receipt
  transfer
  usage
  adjustment
}

// ---------- Acceso ----------

Table app_user {
  id uuid [pk]
  email varchar [unique, not null]
  full_name varchar [not null]
  role user_role [not null]
  password_hash varchar [not null]
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: false, note: 'Contraseña temporal: solo puede cambiarla (E01-05)']
  password_reset_at timestamptz [note: 'Último restablecimiento']
  password_reset_by uuid [ref: > app_user.id, note: 'Quién hizo el último restablecimiento']
}

// ---------- Escuadrillas (D-013) ----------

Table crew {
  id uuid [pk]
  name varchar [not null, note: 'Escuadrilla 1, Escuadrilla 2… Única sin distinguir mayúsculas']
  app_user_id uuid [ref: - app_user.id, unique, note: 'Usuario del celular de la escuadrilla (rol technician)']
  is_active boolean [not null, default: true]
}

Table field_technician {
  id uuid [pk]
  full_name varchar [not null, note: 'Persona de campo. No tiene usuario']
  is_active boolean [not null, default: true]
}

// ---------- Catálogos ----------

Table work_type {
  id uuid [pk]
  name varchar [not null, note: 'Instalación, reparación, service, devolución, retiro, relevamiento. Se guarda sin espacios sobrantes']
  requires_failure_repair boolean [not null, default: false, note: 'El cierre pide falla y reparación (E02-10)']
  is_active boolean [not null, default: true]

  indexes {
    `lower(name)` [unique, name: 'uq_work_type_name', note: 'Sin distinguir mayúsculas, también contra inactivos']
  }
}

Table task {
  id uuid [pk]
  work_type_id uuid [ref: > work_type.id, not null]
  name varchar [not null, note: 'Subtarea predefinida. Se guarda sin espacios sobrantes']
  is_active boolean [not null, default: true]

  indexes {
    (work_type_id, `lower(name)`) [unique, name: 'uq_task_work_type_name', note: 'Única dentro de su tipo de trabajo']
  }
}

Table equipment_type {
  id uuid [pk]
  name varchar [not null, note: 'Aire acondicionado, cámara de frío, heladera comercial, heladera familiar, freezer, otros. Se guarda sin espacios sobrantes']
  code_prefix varchar [note: 'Prefijo del código interno de sus equipos (EA, EH, EC, EF, EO). Sin prefijo se usa EO (D-002)']
  is_active boolean [not null, default: true]

  indexes {
    `lower(name)` [unique, name: 'uq_equipment_type_name', note: 'Sin distinguir mayúsculas, también contra inactivos']
  }
}

Table failure {
  id uuid [pk]
  equipment_type_id uuid [ref: > equipment_type.id, note: 'Null = genérica, aplica a todos los tipos']
  name varchar [not null, note: 'Lista inicial del cliente: 3 genéricas (migración 7a8a9559f9b4). Se guarda sin espacios sobrantes']
  is_active boolean [not null, default: true]

  indexes {
    (`coalesce(equipment_type_id, '00000000-0000-0000-0000-000000000000')`, `lower(name)`) [unique, name: 'uq_failure_scope_name', note: 'Único dentro de su tipo y entre genéricas. El cruce genérica-específica lo chequea el servicio']
  }
}

Table repair {
  id uuid [pk]
  failure_id uuid [ref: > failure.id, not null, note: 'Falla a la que pertenece. Si la falla es de un tipo, la reparación tiene que ser de ese tipo']
  equipment_type_id uuid [ref: > equipment_type.id, note: 'Null = genérica, aplica a todos los tipos. Mismas reglas que failure']
  name varchar [not null, note: 'Lista inicial del cliente (migración 7a8a9559f9b4). Se guarda sin espacios sobrantes']
  is_active boolean [not null, default: true]

  indexes {
    (`coalesce(equipment_type_id, '00000000-0000-0000-0000-000000000000')`, `lower(name)`) [unique, name: 'uq_repair_scope_name', note: 'Único dentro de su tipo y entre genéricas. El cruce genérica-específica lo chequea el servicio']
  }
}

// ---------- Clientes y equipos ----------

Table client {
  id uuid [pk]
  number varchar [unique, not null, note: 'Número de cliente, texto (Persat mezcla series). Forma parte del código de equipo (D-002)']
  name varchar [not null]
  segment client_segment [not null, default: 'unclassified']
  tax_id varchar [note: 'CUIT o DNI. Dato personal, ver SECURITY.md']
  tax_condition tax_condition [note: 'Opcional']
  notes text
}

Table client_contact {
  id uuid [pk]
  client_id uuid [ref: > client.id, not null]
  client_site_id uuid [ref: > client_site.id, note: 'Opcional: contacto de un domicilio. El técnico ve solo el nombre']
  name varchar
  phone varchar
  email varchar
  receives_monthly_report boolean [default: false]
}

Table client_site {
  id uuid [pk]
  client_id uuid [ref: > client.id, not null]
  label varchar [note: 'Opcional: sede, sucursal, planta, depósito']
  address varchar [not null, note: 'Incluye la localidad']
  reference varchar [note: 'Piso, departamento, cómo llegar. Lo ve el técnico']
  is_active boolean [not null, default: true]
}

Table equipment {
  id uuid [pk]
  client_site_id uuid [ref: > client_site.id, not null]
  equipment_type_id uuid [ref: > equipment_type.id, not null]
  brand varchar
  model varchar
  serial_number varchar
  internal_code varchar [unique, not null, note: 'Código interno único en toda la empresa, lo genera el sistema. Texto sin largo fijo (D-002)']
  location_note varchar [not null, note: 'Ubicación dentro del cliente, lo que se muestra primero (D-002)']
  notes text [note: 'Observaciones: potencia, subtipo, gas o lo que no tenga campo propio']
}

// ---------- Órdenes de trabajo ----------

Table work_order {
  id uuid [pk]
  number bigint [unique, not null, note: 'Número correlativo legible']
  kind order_kind [not null, default: 'on_site']
  source order_source [not null, default: 'manual']
  status order_status [not null, note: 'Derivado del último work_order_event, mantenido en la misma transacción']
  client_id uuid [ref: > client.id, not null]
  client_site_id uuid [ref: > client_site.id, not null]
  equipment_id uuid [ref: > equipment.id]
  work_type_id uuid [ref: > work_type.id, not null]
  description text
  channel order_channel [note: 'Por dónde llegó el pedido. Obligatorio en las manuales (E04-02)']
  requester_name varchar [note: 'Quién pidió: nombre y cargo. Opcional, el técnico no lo ve']
  requester_area varchar [note: 'Dónde: sector, piso o ala. Opcional, el técnico lo ve']
  requires_approval boolean [default: false, note: 'Órdenes generadas por mantenimiento hasta su aprobación en bloque. Pendiente D-005. Existe desde E04-03 (siempre false hasta E07-04)']
  maintenance_run_id uuid [ref: > maintenance_run.id, note: 'Se agrega con E07-04']
}

Table work_order_event {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  stage_id uuid [ref: > work_order_stage.id]
  event_type varchar [not null, note: 'Con CHECK sobre los valores válidos: created, status_change, assigned, unassigned, reassigned, review_approved, review_returned, converted_to_workshop, equipment_changed (E04-12). closure_in_review se suma con la historia que lo use']
  from_status order_status
  to_status order_status [note: 'Null en eventos que no cambian el estado']
  occurred_at timestamptz [not null, note: 'Fuente de todas las fechas de negocio de la orden']
  actor_id uuid [ref: > app_user.id]
  note text
}

Table work_order_stage {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  stage_type stage_type [not null]
  sequence int [not null]
  status stage_status [not null, default: 'pending']
}

Table work_order_assignment {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  stage_id uuid [ref: > work_order_stage.id, note: 'Se agrega con taller (E06)']
  crew_id uuid [ref: > crew.id, not null, note: 'Escuadrilla responsable (D-013). Reemplaza a technician_id de E04-03']
  scheduled_for date [not null, note: 'Solo el día, sin hora (E04-03)']
  assigned_at timestamptz [not null]
  unassigned_at timestamptz [note: 'La vigente es la que no lo tiene: índice único parcial, una por orden']
}

Table work_order_closure {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  stage_id uuid [ref: > work_order_stage.id]
  closed_by uuid [ref: > app_user.id, not null, note: 'Usuario de la escuadrilla que cerró']
  closed_at timestamptz [not null]
  outcome closure_outcome [not null]
  failure_id uuid [ref: > failure.id]
  failure_other_text varchar
  repair_id uuid [ref: > repair.id]
  repair_other_text varchar
  equipment_condition equipment_condition [note: 'Nulo si no se pudo hacer']
  not_done_reason not_done_reason [note: 'Solo con outcome not_done']
  observation text
  no_signature_reason no_signature_reason [note: 'Por qué no hay firma (D-011, E05-07). Nulo si hay firma']
  no_signature_text varchar [note: 'Solo y obligatorio con no_signature_reason other']
  idempotency_key uuid [unique, not null, note: 'Generada en el celular. Evita duplicados al sincronizar']
}

Table work_order_cancellation {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null, note: 'Única por orden (índice parcial sin borradas): Cancelada es final']
  reason cancel_reason [not null]
  reason_text varchar [note: 'Solo y obligatorio con reason other (CHECK)']
  cancelled_by uuid [ref: > app_user.id, not null, note: 'Usuario de administración que canceló']
  cancelled_at timestamptz [not null]

  Note: 'Cancelación de la orden por administración (E04-07). El evento de la línea de tiempo guarda el motivo legible'
}

Table work_order_closure_technician {
  closure_id uuid [ref: > work_order_closure.id, not null]
  field_technician_id uuid [ref: > field_technician.id, not null]

  indexes {
    (closure_id, field_technician_id) [pk]
  }

  Note: 'Quiénes fueron (D-013). Base de los trabajos por técnico (E10-02)'
}

Table work_order_closure_task {
  closure_id uuid [ref: > work_order_closure.id, not null]
  task_id uuid [ref: > task.id, not null]

  indexes {
    (closure_id, task_id) [pk]
  }

  Note: 'Tareas del tipo de trabajo que se tildaron al cerrar (E05-04)'
}

Table signature {
  id uuid [pk]
  closure_id uuid [ref: > work_order_closure.id, not null]
  purpose signature_purpose [not null]
  signer_name varchar [not null]
  image_file_id uuid [ref: - stored_file.id, unique, not null, note: 'Imagen de la firma en el bucket (E00-09)']
  signed_at timestamptz [not null]

  Note: 'Firma del cliente. En el cierre no se pide DNI (D-008, E05-07); retiro y devolución a confirmar'
}

Table stored_file {
  id uuid [pk]
  purpose varchar [not null, note: 'Para qué se subió (closure_photo); decide los tipos permitidos']
  object_key varchar [unique, not null, note: 'Clave en el bucket, sin datos personales. Nunca el archivo en la base']
  content_type varchar [not null]
  size_bytes bigint [not null]
  uploaded_by uuid [ref: > app_user.id, not null]
  confirmed_at timestamptz [note: 'Nulo hasta que el servidor comprueba el objeto en el bucket']

  Note: 'Archivo del bucket S3 compatible (E00-09). Se descarga con URL firmada de corta duración'
}

Table work_order_closure_photo {
  closure_id uuid [ref: > work_order_closure.id, not null]
  file_id uuid [ref: - stored_file.id, unique, not null]
  position int [not null]
  indexes {
    (closure_id, file_id) [pk]
  }

  Note: 'Fotos del cierre, hasta 5 (E05-06)'
}

// ---------- Repuestos, precios y mano de obra ----------

Table part {
  id uuid [pk]
  name varchar [not null]
  unit varchar [not null, default: 'unidad']
  code varchar [note: 'Hoy los repuestos no tienen código']
  is_active boolean [default: true]
}

Table part_price {
  id uuid [pk]
  part_id uuid [ref: > part.id, not null]
  list_price numeric(14,2) [not null, note: 'ADMIN']
  valid_from timestamptz [not null]
}

Table part_usage {
  id uuid [pk]
  closure_id uuid [ref: > work_order_closure.id, not null]
  part_id uuid [ref: > part.id, not null]
  quantity numeric(12,3) [not null]
  unit_price numeric(14,2) [not null, note: 'ADMIN. Estampado al usar, no cambia si cambia la lista']
  stock_location_id uuid [ref: > stock_location.id]
  used_at timestamptz [not null]
}

Table work_order_charge {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  concept varchar [not null, note: 'Mano de obra, visita, otro']
  amount numeric(14,2) [not null, note: 'ADMIN']
  charged_at timestamptz [not null]
}

// ---------- Facturación y cobro ----------

Table invoice_record {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  invoice_number varchar [not null, note: 'La factura se emite en el sistema de facturación del cliente. Datos exactos: D-004']
  recorded_at timestamptz [not null]
  recorded_by uuid [ref: > app_user.id, not null]
}

Table payment_record {
  id uuid [pk]
  work_order_id uuid [ref: > work_order.id, not null]
  recorded_at timestamptz [not null]
  recorded_by uuid [ref: > app_user.id, not null]
}

// ---------- Stock ----------

Table stock_location {
  id uuid [pk]
  type stock_location_type [not null]
  name varchar [not null]
  technician_id uuid [ref: > app_user.id, note: 'Para camionetas']
}

Table stock_movement {
  id uuid [pk]
  part_id uuid [ref: > part.id, not null]
  from_location_id uuid [ref: > stock_location.id]
  to_location_id uuid [ref: > stock_location.id]
  quantity numeric(12,3) [not null]
  reason stock_movement_reason [not null]
  part_usage_id uuid [ref: > part_usage.id]
  moved_at timestamptz [not null]
  moved_by uuid [ref: > app_user.id, not null]
  note varchar
}

// ---------- Mantenimiento preventivo ----------

Table checklist_template {
  id uuid [pk]
  name varchar [not null]
  frequency maintenance_frequency [not null]
  equipment_type_id uuid [ref: > equipment_type.id, note: 'Null = plantilla general de esa frecuencia']
}

Table checklist_template_item {
  id uuid [pk]
  template_id uuid [ref: > checklist_template.id, not null]
  position int [not null]
  label varchar [not null]
  kind checklist_item_kind [not null]
  unit varchar [note: 'Para mediciones: V, A, °C, bar']
  expected_min numeric(12,3)
  expected_max numeric(12,3)
}

Table maintenance_plan {
  id uuid [pk]
  client_id uuid [ref: > client.id, not null, note: 'Abono']
  name varchar
}

Table maintenance_plan_equipment {
  id uuid [pk]
  plan_id uuid [ref: > maintenance_plan.id, not null]
  equipment_id uuid [ref: > equipment.id, not null]
  frequency maintenance_frequency [not null]
  starts_on date [not null]
  ends_on date
}

Table maintenance_run {
  id uuid [pk]
  period varchar(7) [unique, not null, note: 'AAAA-MM']
  generated_at timestamptz [not null]
  approved_at timestamptz
  approved_by uuid [ref: > app_user.id]
}

Table checklist_result {
  id uuid [pk]
  closure_id uuid [ref: > work_order_closure.id, not null]
  template_item_id uuid [ref: > checklist_template_item.id, not null]
  result varchar [note: 'ok o not_ok para ítems ok_no']
  measured_value numeric(12,3)
  out_of_range boolean
  observation text
}

// ---------- Informes, auditoría y migración ----------

Table monthly_report_delivery {
  id uuid [pk]
  client_id uuid [ref: > client.id, not null]
  period varchar(7) [not null]
  to_email varchar [not null]
  status varchar [not null, note: 'queued, sent, failed']
  sent_at timestamptz
}

Table audit_log {
  id uuid [pk]
  actor_id uuid [ref: > app_user.id]
  entity varchar [not null]
  entity_id uuid [not null]
  action varchar [not null]
  changes jsonb
  at timestamptz [not null]
}

Table legacy_reference {
  id uuid [pk]
  entity varchar [not null]
  entity_id uuid [not null]
  source varchar [not null, default: 'persat']
  legacy_id varchar [not null]
  imported_at timestamptz [not null]
  indexes {
    (entity, source, legacy_id) [unique]
  }
}
